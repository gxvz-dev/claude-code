<?xml version="1.0" encoding="utf-8"?>
<!--
  Claude Desktop administrative template.
  Writes HKLM\SOFTWARE\Policies\Claude. Keys and behavior follow:
  https://support.claude.com/en/articles/12622667-enterprise-configuration-for-claude-desktop
-->
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions"
                   revision="1.0" schemaVersion="1.0">
  <policyNamespaces>
    <target prefix="claudedesktop" namespace="Anthropic.Policies.ClaudeDesktop" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_ClaudeDesktop" displayName="$(string.SUPPORTED_ClaudeDesktop)" />
      <definition name="SUPPORTED_ClaudeDesktop_1_25927" displayName="$(string.SUPPORTED_ClaudeDesktop_1_25927)" />
    </definitions>
  </supportedOn>
  <categories>
    <category name="Cat_ClaudeDesktop" displayName="$(string.Cat_ClaudeDesktop)" />
    <category name="Cat_ClaudeCode" displayName="$(string.Cat_ClaudeCode)">
      <parentCategory ref="Cat_ClaudeDesktop" />
    </category>
    <category name="Cat_Cowork" displayName="$(string.Cat_Cowork)">
      <parentCategory ref="Cat_ClaudeDesktop" />
    </category>
    <category name="Cat_Extensions" displayName="$(string.Cat_Extensions)">
      <parentCategory ref="Cat_ClaudeDesktop" />
    </category>
    <category name="Cat_SignIn" displayName="$(string.Cat_SignIn)">
      <parentCategory ref="Cat_ClaudeDesktop" />
    </category>
    <category name="Cat_Updates" displayName="$(string.Cat_Updates)">
      <parentCategory ref="Cat_ClaudeDesktop" />
    </category>
  </categories>
  <policies>

    <!-- Claude Code -->
    <policy name="isClaudeCodeForDesktopEnabled" class="Machine"
            displayName="$(string.isClaudeCodeForDesktopEnabled)"
            explainText="$(string.isClaudeCodeForDesktopEnabled_Explain)"
            key="SOFTWARE\Policies\Claude" valueName="isClaudeCodeForDesktopEnabled">
      <parentCategory ref="Cat_ClaudeCode" />
      <supportedOn ref="SUPPORTED_ClaudeDesktop" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy name="effortLevel" class="Machine"
            displayName="$(string.effortLevel)"
            explainText="$(string.effortLevel_Explain)"
            presentation="$(presentation.effortLevel)"
            key="SOFTWARE\Policies\Claude">
      <parentCategory ref="Cat_ClaudeCode" />
      <supportedOn ref="SUPPORTED_ClaudeDesktop_1_25927" />
      <elements>
        <enum id="effortLevel" valueName="effortLevel" required="true">
          <item displayName="$(string.effortLevel_low)"><value><string>low</string></value></item>
          <item displayName="$(string.effortLevel_medium)"><value><string>medium</string></value></item>
          <item displayName="$(string.effortLevel_high)"><value><string>high</string></value></item>
          <item displayName="$(string.effortLevel_xhigh)"><value><string>xhigh</string></value></item>
          <item displayName="$(string.effortLevel_max)"><value><string>max</string></value></item>
        </enum>
      </elements>
    </policy>

    <!-- Cowork -->
    <policy name="secureVmFeaturesEnabled" class="Machine"
            displayName="$(string.secureVmFeaturesEnabled)"
            explainText="$(string.secureVmFeaturesEnabled_Explain)"
            key="SOFTWARE\Policies\Claude" valueName="secureVmFeaturesEnabled">
      <parentCategory ref="Cat_Cowork" />
      <supportedOn ref="SUPPORTED_ClaudeDesktop" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy name="allowedWorkspaceFolders" class="Machine"
            displayName="$(string.allowedWorkspaceFolders)"
            explainText="$(string.allowedWorkspaceFolders_Explain)"
            presentation="$(presentation.allowedWorkspaceFolders)"
            key="SOFTWARE\Policies\Claude">
      <parentCategory ref="Cat_Cowork" />
      <supportedOn ref="SUPPORTED_ClaudeDesktop" />
      <elements>
        <text id="allowedWorkspaceFolders" valueName="allowedWorkspaceFolders" required="true" maxLength="8192" />
      </elements>
    </policy>

    <!-- Extensions and MCP -->
    <policy name="isDesktopExtensionEnabled" class="Machine"
            displayName="$(string.isDesktopExtensionEnabled)"
            explainText="$(string.isDesktopExtensionEnabled_Explain)"
            key="SOFTWARE\Policies\Claude" valueName="isDesktopExtensionEnabled">
      <parentCategory ref="Cat_Extensions" />
      <supportedOn ref="SUPPORTED_ClaudeDesktop" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy name="isDesktopExtensionDirectoryEnabled" class="Machine"
            displayName="$(string.isDesktopExtensionDirectoryEnabled)"
            explainText="$(string.isDesktopExtensionDirectoryEnabled_Explain)"
            key="SOFTWARE\Policies\Claude" valueName="isDesktopExtensionDirectoryEnabled">
      <parentCategory ref="Cat_Extensions" />
      <supportedOn ref="SUPPORTED_ClaudeDesktop" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy name="isLocalDevMcpEnabled" class="Machine"
            displayName="$(string.isLocalDevMcpEnabled)"
            explainText="$(string.isLocalDevMcpEnabled_Explain)"
            key="SOFTWARE\Policies\Claude" valueName="isLocalDevMcpEnabled">
      <parentCategory ref="Cat_Extensions" />
      <supportedOn ref="SUPPORTED_ClaudeDesktop" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Sign-in -->
    <policy name="forceLoginOrgUUID" class="Machine"
            displayName="$(string.forceLoginOrgUUID)"
            explainText="$(string.forceLoginOrgUUID_Explain)"
            presentation="$(presentation.forceLoginOrgUUID)"
            key="SOFTWARE\Policies\Claude">
      <parentCategory ref="Cat_SignIn" />
      <supportedOn ref="SUPPORTED_ClaudeDesktop" />
      <elements>
        <text id="forceLoginOrgUUID" valueName="forceLoginOrgUUID" required="true" maxLength="4096" />
      </elements>
    </policy>

    <!-- Updates -->
    <policy name="disableAutoUpdates" class="Machine"
            displayName="$(string.disableAutoUpdates)"
            explainText="$(string.disableAutoUpdates_Explain)"
            key="SOFTWARE\Policies\Claude" valueName="disableAutoUpdates">
      <parentCategory ref="Cat_Updates" />
      <supportedOn ref="SUPPORTED_ClaudeDesktop" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy name="autoUpdaterEnforcementHours" class="Machine"
            displayName="$(string.autoUpdaterEnforcementHours)"
            explainText="$(string.autoUpdaterEnforcementHours_Explain)"
            presentation="$(presentation.autoUpdaterEnforcementHours)"
            key="SOFTWARE\Policies\Claude">
      <parentCategory ref="Cat_Updates" />
      <supportedOn ref="SUPPORTED_ClaudeDesktop" />
      <elements>
        <decimal id="autoUpdaterEnforcementHours" valueName="autoUpdaterEnforcementHours" required="true" minValue="1" maxValue="72" />
      </elements>
    </policy>

  </policies>
</policyDefinitions>
